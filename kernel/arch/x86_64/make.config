$(ARCHDIR)/interrupts/isr_stubs.o \
$(ARCHDIR)/interrupts/isr_handler.o \
$(ARCHDIR)/interrupt_controllers/pic.o \
$(ARCHDIR)/idt/idt.o \
$(ARCHDIR)/idt/idt_init.o \
$(ARCHDIR)/memory/vmm.o \
$(ARCHDIR)/memory/buddy_allocator.o \

